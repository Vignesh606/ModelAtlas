# Copy to .env.local and fill in. Never commit real values.

# Server-side OpenRouter key used by the playground (https://openrouter.ai/keys).
# Optional: without it, users must paste their own key in the playground settings.
OPENROUTER_API_KEY=

# Optional: default playground model id. If unset, the best-scoring free model is used.
OPENROUTER_DEFAULT_MODEL=

# Postgres connection string (Neon recommended). Without it, request history is disabled.
# Run `npm run db:migrate` once against a new database to create the tables.
DATABASE_URL=

# Optional server keys for other providers (OpenAI-compatible APIs). With one set,
# that provider's models load automatically and become the playground default.
# Gemini (Google AI Studio): GEMINI_API_KEY (GOOGLE_API_KEY also works). Others:
# OPENAI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY, DEEPSEEK_API_KEY, MISTRAL_API_KEY,
# XAI_API_KEY, TOGETHER_API_KEY, FIREWORKS_API_KEY.
GEMINI_API_KEY=
