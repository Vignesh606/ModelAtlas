# Copy to .env.local and fill in. Never commit real values.

# Primary server-side Google Gemini API key used by the playground (https://aistudio.google.com/apikey).
# GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Optional: default Gemini model id (defaults to gemini-2.5-flash).
GEMINI_DEFAULT_MODEL=

# Postgres connection string (Neon recommended). Without it, request history is disabled.
# Run `npm run db:migrate` once against a new database to create the tables.
DATABASE_URL=

# Optional server keys for other providers (OpenAI-compatible APIs). With one set,
# that provider's models load automatically in the playground.
# OPENROUTER_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY,
# DEEPSEEK_API_KEY, MISTRAL_API_KEY, XAI_API_KEY, TOGETHER_API_KEY, FIREWORKS_API_KEY.
OPENROUTER_API_KEY=

# Optional: default OpenRouter model id if using OpenRouter.
OPENROUTER_DEFAULT_MODEL=
